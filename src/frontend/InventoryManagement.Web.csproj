<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>InventoryManagement.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="InventoryDesignSystem\InventoryDesignSystem.csproj" />
  </ItemGroup>

  <!-- InventoryDesignSystemは別プロジェクトのため、既定のファイル探索対象から除外する -->
  <ItemGroup>
    <Compile Remove="InventoryDesignSystem\**" />
    <Content Remove="InventoryDesignSystem\**" />
    <None Remove="InventoryDesignSystem\**" />
    <RazorComponent Remove="InventoryDesignSystem\**" />
    <_ContentIncludedByDefault Remove="InventoryDesignSystem\**" />
  </ItemGroup>

</Project>
